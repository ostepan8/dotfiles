<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ostepan.wnba-market-snapshot</string>

    <!-- Kalshi + Polymarket price snapshots for wnba-analytics-engine, every
         2 hours. Snapshots are append-only time series (see
         market_price_snapshots) -- this cadence is what actually builds
         usable intra-day line-movement history, unlike a once-daily run. -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/dotfiles/mac/wnba-analytics-engine/market-snapshot.sh"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>RunAtLoad</key>
    <true/>

    <key>StartInterval</key>
    <integer>7200</integer>

    <key>StandardOutPath</key>
    <string>/tmp/wnba-market-snapshot.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/wnba-market-snapshot.err</string>
</dict>
</plist>
