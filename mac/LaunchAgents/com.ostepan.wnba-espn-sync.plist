<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
  "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ostepan.wnba-espn-sync</string>

    <!-- Daily trailing-window ESPN box-score sync for wnba-analytics-engine
         (see wnba_engine/cli/main.py's sync-recent command). Catches games
         that were 'scheduled' on first ingest and have since gone final. -->

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>-c</string>
        <string>exec "$HOME/dotfiles/mac/wnba-analytics-engine/espn-sync.sh"</string>
    </array>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/opt/homebrew/sbin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key>
        <integer>8</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/wnba-espn-sync.out</string>

    <key>StandardErrorPath</key>
    <string>/tmp/wnba-espn-sync.err</string>
</dict>
</plist>
