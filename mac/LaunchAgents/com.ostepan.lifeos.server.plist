<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.ostepan.lifeos.server</string>

  <!-- Resolved through a login shell so no machine-specific project path is
       baked into the plist; `life` lives on PATH via ~/.local/bin. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/sh</string>
    <string>-lc</string>
    <string>PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin"; export PATH; command -v life >/dev/null 2>&1 || { sleep 3600; exit 0; }; exec life serve --port 7777 --host 127.0.0.1 >> "$HOME/Library/Logs/lifeos-server.log" 2>&amp;1</string>
  </array>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
