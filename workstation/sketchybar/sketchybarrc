#!/usr/bin/env bash
# Sketchybar config — Gruvbox Dark Hard, minimal polish.
# Icons: JetBrainsMono Nerd Font (Font Awesome / MDI classic glyphs that render reliably).
# Docs: https://felixkratz.github.io/SketchyBar/

PLUGIN_DIR="$HOME/.config/sketchybar/plugins"

# ---------- Gruvbox Dark Hard palette ----------
BG_TRANSPARENT=0x00000000
BG_BAR=0xf01d2021           # 94% opacity bar background
BG_ITEM=0xff3c3836
BG_ACCENT=0xffd65d0e        # orange — active workspace
FG=0xffebdbb2
DIM=0xff928374
RED=0xffcc241d
GREEN=0xff98971a
YELLOW=0xffd79921
BLUE=0xff458588
PURPLE=0xffb16286
AQUA=0xff689d6a
BLACK=0xff1d2021

# ---------- Bar ----------
# display=main pins it to the macOS "main display" only (set via System Settings
# → Displays → drag the white bar to the desired monitor). Avoids per-monitor
# glitches in multi-monitor setups. Use display=all if you want one per screen.
sketchybar --bar \
    position=top \
    display=main \
    height=32 \
    blur_radius=40 \
    color=$BG_BAR \
    padding_left=12 \
    padding_right=12 \
    y_offset=0 \
    corner_radius=0 \
    margin=0 \
    sticky=on \
    topmost=on

# ---------- Defaults ----------
sketchybar --default \
    icon.font="JetBrainsMono Nerd Font:Bold:14.0" \
    icon.color=$FG \
    label.font="SF Pro:Semibold:13.0" \
    label.color=$FG \
    padding_left=6 \
    padding_right=6 \
    icon.padding_left=8 \
    icon.padding_right=6 \
    label.padding_left=0 \
    label.padding_right=8 \
    background.color=$BG_TRANSPARENT \
    background.corner_radius=8 \
    background.height=24

# ==============================================================
# LEFT: workspace indicators + front app
# ==============================================================
sketchybar --add event aerospace_workspace_change

for sid in $(aerospace list-workspaces --all); do
    sketchybar --add item space.$sid left \
        --subscribe space.$sid aerospace_workspace_change \
        --set space.$sid \
            background.color=$BG_TRANSPARENT \
            background.corner_radius=12 \
            background.height=24 \
            background.drawing=on \
            icon.drawing=off \
            label="$sid" \
            label.font="SF Pro:Bold:13.0" \
            label.padding_left=10 \
            label.padding_right=10 \
            padding_left=1 \
            padding_right=1 \
            click_script="aerospace workspace $sid" \
            script="$PLUGIN_DIR/aerospace.sh $sid"
done

sketchybar --add item spacer.left left \
    --set spacer.left \
        background.drawing=off \
        icon.drawing=off \
        label.drawing=off \
        width=12

sketchybar --add item front_app left \
    --set front_app \
        background.drawing=off \
        icon.drawing=off \
        label.font="SF Pro:Bold:13.0" \
        label.color=$FG \
        script="$PLUGIN_DIR/front_app.sh" \
    --subscribe front_app front_app_switched

# Next calendar event (hidden when none). Reads macOS Calendar via icalBuddy.
sketchybar --add item calendar left \
    --set calendar \
        update_freq=60 \
        background.color=$BG_ITEM \
        drawing=off \
        icon.color=$AQUA \
        click_script="open -a Calendar" \
        script="$PLUGIN_DIR/calendar.sh"

# ==============================================================
# CENTER: transport controls + now-playing (Spotify or Apple Music)
# Hidden when nothing is playing/paused. The `media` item polls and drives
# the three control buttons, so only one script does the work.
# ==============================================================
sketchybar --add item media.back center \
    --set media.back drawing=off background.drawing=off label.drawing=off \
        icon.padding_left=6 icon.padding_right=6 padding_left=1 padding_right=1 \
        click_script="$PLUGIN_DIR/media.sh prev"

sketchybar --add item media.play center \
    --set media.play drawing=off background.drawing=off label.drawing=off \
        icon.padding_left=6 icon.padding_right=6 padding_left=1 padding_right=1 \
        click_script="$PLUGIN_DIR/media.sh playpause"

sketchybar --add item media.next center \
    --set media.next drawing=off background.drawing=off label.drawing=off \
        icon.padding_left=6 icon.padding_right=6 padding_left=1 padding_right=1 \
        click_script="$PLUGIN_DIR/media.sh next"

sketchybar --add item media center \
    --set media \
        update_freq=10 \
        background.color=$BG_ITEM \
        label.color=$AQUA \
        drawing=off \
        script="$PLUGIN_DIR/media.sh"

# ==============================================================
# RIGHT (added in reverse — first added appears rightmost)
# Clock, Wi-Fi, and Battery live here because the bar is topmost=on and now
# covers the native macOS menu bar (which used to show them). Added first so
# they sit at the far right, like the native menu bar's clock/status cluster.
# ==============================================================

# Clock (rightmost) — day + time.
sketchybar --add item clock right \
    --set clock \
        update_freq=15 \
        background.color=$BG_ITEM \
        icon.drawing=off \
        label.color=$FG \
        click_script="open -a Calendar" \
        script="$PLUGIN_DIR/clock.sh"

sketchybar --add item sep.clock right \
    --set sep.clock background.drawing=off icon.drawing=off label.drawing=off width=8

# Battery
sketchybar --add item battery right \
    --set battery \
        update_freq=30 \
        background.color=$BG_ITEM \
        script="$PLUGIN_DIR/battery.sh"

sketchybar --add item sep.bat right \
    --set sep.bat background.drawing=off icon.drawing=off label.drawing=off width=8

# Wi-Fi
sketchybar --add item wifi right \
    --set wifi \
        update_freq=30 \
        background.color=$BG_ITEM \
        click_script="open -a 'System Settings' --args 'Network'" \
        script="$PLUGIN_DIR/wifi.sh"

sketchybar --add item sep.wifi right \
    --set sep.wifi background.drawing=off icon.drawing=off label.drawing=off width=8

# Weather (wttr.in — no API key).
sketchybar --add item weather right \
    --set weather \
        update_freq=900 \
        background.color=$BG_ITEM \
        click_script="open -a Weather" \
        script="$PLUGIN_DIR/weather.sh"

sketchybar --add item sep.w right \
    --set sep.w background.drawing=off icon.drawing=off label.drawing=off width=8

# Keep-awake toggle (caffeinate). Click to flip.
sketchybar --add item caffeine right \
    --set caffeine \
        update_freq=30 \
        background.color=$BG_ITEM \
        click_script="$PLUGIN_DIR/caffeine.sh toggle" \
        script="$PLUGIN_DIR/caffeine.sh"

sketchybar --add item sep.w2 right \
    --set sep.w2 background.drawing=off icon.drawing=off label.drawing=off width=8

# Volume / mute
sketchybar --add item volume right \
    --set volume \
        background.color=$BG_ITEM \
        script="$PLUGIN_DIR/volume.sh" \
        click_script="open -a 'System Settings' --args 'Sound'" \
    --subscribe volume volume_change

sketchybar --add item sep.3 right \
    --set sep.3 background.drawing=off icon.drawing=off label.drawing=off width=8

# CPU + RAM (not shown in the native menu bar)
sketchybar --add item cpu right \
    --set cpu \
        update_freq=5 \
        background.color=$BG_ITEM \
        script="$PLUGIN_DIR/cpu.sh"

sketchybar --add item ram right \
    --set ram \
        update_freq=10 \
        background.color=$BG_ITEM \
        script="$PLUGIN_DIR/ram.sh"

# ---------- Finalize ----------
sketchybar --update
