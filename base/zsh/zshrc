# Resolve the account an agent CLI is ACTUALLY logged into. These labels used to
# be hardcoded per function, which silently lied for months after
# .claude-personal was re-authed to a different account: the tab claimed one
# identity while Remote Control (which follows the profile's real OAuth token)
# connected as another. Derive them, so a title can never drift from the login.
function _ccd_account() {
  local email
  email=$(jq -r '.oauthAccount.emailAddress // empty' "$1/.claude.json" 2>/dev/null)
  print -r -- "${email:-logged out}"
}

# Codex has ONE account (the subscription), so there is no profile dir to pass —
# CODEX_HOME is always ~/.codex. auth.json exists only after `codex login`.
# The address is normally a claim inside the id_token JWT rather than a plain
# field, so fall through to decoding it. `codex login status` is no help: it
# reports only the provider ("Logged in using ChatGPT"), never which account.
function _cxd_account() {
  local auth="$HOME/.codex/auth.json" email payload
  [[ -f "$auth" ]] || { print -r -- "logged out"; return }
  email=$(jq -r '[.. | objects | select(has("email")) | .email] | first // empty' "$auth" 2>/dev/null)
  if [[ -z "$email" ]]; then
    payload=$(jq -r '.tokens.id_token // empty' "$auth" 2>/dev/null | cut -d. -f2)
    [[ -n "$payload" ]] && email=$(printf '%s' "$payload" | tr '_-' '/+' \
      | awk '{ while (length($0) % 4) $0 = $0 "="; print }' \
      | base64 -d 2>/dev/null \
      | jq -r '[.. | objects | select(has("email")) | .email] | first // empty' 2>/dev/null)
  fi
  print -r -- "${email:-signed in}"
}

function _agent_label_claude() { print -r -- "Claude · $(_ccd_account "$1")"; }
function _agent_label_codex()  { print -r -- "Codex · $(_cxd_account)"; }

# Pin a terminal title for as long as an agent CLI runs. Shared by both families
# so this loop exists once. The label is re-resolved every ~5s so it corrects
# itself after an in-session login.
function _agent_title() {
  local labeler="$1" arg="$2"; shift 2
  # No controlling terminal (script, cron, CI, a background job): run the agent
  # directly. Skipping this also avoids spawning a loop that cannot write.
  #
  # The obvious guard does NOT work: `printf ... > /dev/tty 2>/dev/null` still
  # prints "device not configured: /dev/tty", because zsh reports the failed
  # redirection itself before the 2>/dev/null is in effect. Only wrapping the
  # redirection in a group, as below, actually silences it — which is why the
  # errors survived an earlier attempt to suppress them inline.
  if ! { : > /dev/tty } 2>/dev/null; then
    "$@"
    return
  fi
  (
    local label="" tick=0
    while true; do
      (( tick % 5 == 0 )) && label="$("$labeler" "$arg")"
      { printf '\033]0;%s\007' "$label" > /dev/tty } 2>/dev/null
      (( tick++ ))
      sleep 1
    done
  ) &
  local _pid=$!
  "$@"
  kill $_pid 2>/dev/null
  # Guarded like the write inside the loop. Without 2>/dev/null this line emits
  # "device not configured: /dev/tty" whenever there is no controlling terminal
  # — running one of these wrappers from a script, a cron job, or any non-tty
  # context printed a spurious error after an otherwise successful run.
  { printf '\033]0;\007' > /dev/tty } 2>/dev/null
}

# Single definition of the per-profile launch, so a config dir is never
# spelled out in more than one place.
function _ccd_run() {
  local dir="$1"; shift
  _agent_title _agent_label_claude "$dir" env CLAUDE_CONFIG_DIR="$dir" claude --dangerously-skip-permissions "$@"
}
function ccd()  { _ccd_run "$HOME/.claude-personal" "$@"; }
function ccds() { _ccd_run "$HOME/.claude-school"   "$@"; }
function ccdw() { _ccd_run "$HOME/.claude-work"     "$@"; }
function ccdr()  { ccd  --resume "$@"; }
function ccdrs() { ccds --resume "$@"; }
function ccdrw() { ccdw --resume "$@"; }

# --- Codex, mirroring the ccd family ---
#
# --dangerously-bypass-approvals-and-sandbox is Codex's counterpart to Claude's
# --dangerously-skip-permissions: the FULL bypass. It is not --full-auto and not
# `--ask-for-approval never`; both of those still confine the run to the sandbox.
#
# Codex resumes via a SUBCOMMAND, not a flag: bare `resume` opens the session
# picker, `--last` continues the most recent. The bypass flag is accepted ahead
# of a subcommand, so one runner covers every variant.
function _cxd_run() {
  _agent_title _agent_label_codex "" codex --dangerously-bypass-approvals-and-sandbox "$@"
}
function cxd()   { _cxd_run "$@"; }
function cxdr()  { _cxd_run resume "$@"; }         # session picker
function cxdrl() { _cxd_run resume --last "$@"; }  # most recent, no picker
# The Subconscious gateway survives as a dormant profile in ~/.codex/config.toml.
function cxdsub() { _cxd_run --profile subconscious "$@"; }

# --- Local models, for working offline ---
#
# claude-local already owns the answer to "which local model is current": it
# keeps the base tag in ~/.claude-local/model. Codex reads that SAME file, so
# `claude-local-setup <tag>` switches both tools at once instead of each CLI
# holding its own idea of the local default and drifting.
#
# Both must run the DERIVED "-cc" tag rather than the base one. Ollama serves
# every tag at num_ctx=4096 regardless of what the weights support, which
# silently truncates an agent's system prompt from the very first turn — it
# reads as the model answering a question nobody asked, not as a config error.
# claude-local-setup builds and maintains that sibling; this only points at it.
function _local_model() {
  local base
  base=$(cat "$HOME/.claude-local/model" 2>/dev/null) || return 1
  [[ -n "$base" ]] || return 1
  print -r -- "${base%-cc}-cc"
}
function _agent_label_codex_local() { print -r -- "Codex · local · $1"; }

# claude-local starts Ollama for you when it is not answering (cl_ensure_server);
# cxl must do the same or the two halves of the offline setup behave differently
# on exactly the morning you have no signal to look up why. Same strategy: open
# the app on macOS, otherwise background the server, then wait for it.
function _ensure_ollama() {
  local host="${CLAUDE_LOCAL_HOST:-http://localhost:11434}" i
  curl -fsS --max-time 2 "$host/api/tags" >/dev/null 2>&1 && return 0
  print -u2 "cxl: Ollama not responding at $host — starting it"
  if [[ "$(uname -s)" == "Darwin" && -d /Applications/Ollama.app ]]; then
    open -a Ollama
  else
    (ollama serve >/dev/null 2>&1 &)
  fi
  for i in {1..30}; do
    curl -fsS --max-time 2 "$host/api/tags" >/dev/null 2>&1 && return 0
    sleep 1
  done
  print -u2 "cxl: Ollama still unreachable at $host after 30s"
  return 1
}

# Codex against the local model. --oss selects the OSS provider path, which for
# ollama speaks the Responses API on :11434 (NOT the Anthropic /v1/messages
# route claude-local uses — the two CLIs reach the same server by different
# protocols). Sandbox bypass matches cxd; offline weights are already trusted.
function cxl() {
  local model
  # -m/--model overrides for this run only, mirroring claude-local. The state
  # file is untouched, so a one-off on a smaller model does not silently become
  # the default for the other harness too.
  if [[ "$1" == "-m" || "$1" == "--model" ]]; then
    [[ -n "${2:-}" ]] || { print -u2 "cxl: $1 needs a model tag"; return 1 }
    model="${2%-cc}-cc"; shift 2
  else
    model=$(_local_model) || {
      print -u2 "cxl: no local model set — run: claude-local-setup <tag>"; return 1
    }
  fi
  _ensure_ollama || return 1
  ollama show "$model" >/dev/null 2>&1 || {
    print -u2 "cxl: '$model' is not built — run: claude-local-setup ${model%-cc}"; return 1
  }
  # Codex holds no metadata for an Ollama tag — it says so ("Defaulting to
  # fallback metadata") and then guesses a context window. Read the real num_ctx
  # baked into the -cc sibling and hand Codex exactly that, with an auto-compact
  # limit below it. Without this Codex happily fills past what the server can
  # hold and the conversation is silently truncated: the same trap claude-local
  # documents for CLAUDE_CODE_MAX_CONTEXT_TOKENS, reached by a different route.
  # model_context_window and model_auto_compact_token_limit are the accepted
  # spellings — verified with --strict-config; context_window and
  # model_max_output_tokens are both rejected as unknown fields.
  local ctx; local -a ctxargs
  ctx=$(ollama show "$model" 2>/dev/null | awk '$1=="num_ctx" {print $2; exit}')
  [[ -n "$ctx" ]] && ctxargs=(-c "model_context_window=$ctx" \
                              -c "model_auto_compact_token_limit=$(( ctx * 85 / 100 ))")
  # CODEX_HOME is swapped to a stripped local profile, the same reason
  # claude-local points at ~/.claude-local: it carries no MCP servers, so the
  # prompt stays short. A local model re-pays every system-prompt token on every
  # turn, and the cloud config's blender server alone doubled a trivial round
  # trip from ~8k to ~16k tokens.
  _agent_title _agent_label_codex_local "$model" \
    env CODEX_HOME="$HOME/.codex-local" \
      codex --oss --local-provider ollama -m "$model" "${ctxargs[@]}" \
        --dangerously-bypass-approvals-and-sandbox "$@"
}
# NOTE: config.toml sets model_reasoning_effort = "max", so a local model that
# cannot think is rejected outright by Ollama ("does not support thinking") —
# llama3.2 fails this way, the qwen3.x family does not. Pick a thinking model
# for local work, or override per-run with -c model_reasoning_effort=none.
# cxlr/cxlrl must HOIST a leading -m/--model ahead of the injected `resume`.
# Without this the subcommand lands in $1, cxl's own -m parser never sees the
# flag, and it is forwarded to codex after the subcommand where it means
# something else entirely — so `cxlr -m <tag>` silently ran the default model
# while the completion cheerfully offered tags for it.
function _cxl_resume() {
  local last="$1"; shift
  local -a m
  if [[ "$1" == "-m" || "$1" == "--model" ]]; then m=("$1" "$2"); shift 2; fi
  if [[ "$last" == 1 ]]; then cxl "${m[@]}" resume --last "$@"
  else                        cxl "${m[@]}" resume "$@"; fi
}
function cxlr()  { _cxl_resume 0 "$@"; }  # session picker
function cxlrl() { _cxl_resume 1 "$@"; }  # most recent, no picker

# Claude's side of the same pair, named for symmetry with the cx*/cc* families.
