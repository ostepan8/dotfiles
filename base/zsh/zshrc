# ta [name] -> attach. A function rather than an alias so it can carry its own
# completion: zsh expands aliases before completing, so `alias ta='tmux attach'`
# completed as `tmux attach <TAB>`, which offers flags — session names only
# complete after -t. Completion is registered below, after compinit.
#
# Clear any stale `ta` alias first. zsh expands aliases before resolving
# functions, so an older `alias ta=...` still live in a re-sourced session
# would shadow this function entirely — `reload` would silently keep the old
# behavior. unalias makes re-sourcing converge to the function, not just a
# fresh shell.
unalias ta 2>/dev/null || true
ta() {
  if [ $# -gt 0 ]; then
    tmux attach -t "$1"      # explicit target; let a bad name report its error
  else
    tmux attach              # no arg -> most recent session
  fi
}

# ---------- completions + plugins ----------
# Generated completions are committed so a fresh machine has tab completion
# without running any generator. These are #compdef-style files, which zsh
# AUTOLOADS on first use — the 4k-line codex completion costs nothing at shell
# startup, unlike sourcing it. Must precede compinit or it will not be indexed.
fpath=("$HOME/dotfiles/base/zsh/completions" $fpath)
autoload -Uz compinit && compinit

# `ta <TAB>` -> live tmux session names. Must follow compinit, since compdef is
# defined by it. (f) splits on newlines so session names containing spaces
# survive as single candidates.
_ta() { compadd -- ${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"} }
compdef _ta ta

# Every cx* wrapper forwards to codex, so they inherit codex's own completion —
# generated by `codex completion zsh`, so it tracks the CLI instead of drifting
# from a hand-written list. Regenerate with:
#   codex completion zsh > base/zsh/completions/_codex
compdef _codex cxd cxdr cxdrl cxdsub 2>/dev/null

# cxl* take a -m the plain codex completion knows nothing about, so they get a
# wrapper that offers installed tags there and defers to _codex otherwise. The
# derived -cc siblings are filtered out for the same reason claude-local filters
# them: picking one only round-trips back through the base tag.
_cxl() {
  if [[ "${words[CURRENT-1]}" == "-m" || "${words[CURRENT-1]}" == "--model" ]]; then
    compadd -- ${(f)"$(ollama list 2>/dev/null | awk 'NR>1 && $1 != "" {print $1}' | grep -v -- '-cc$')"}
    return
  fi
  if (( CURRENT == 2 )); then compadd -- -m --model; fi
  _codex
}
compdef _cxl cxl cxlr cxlrl 2>/dev/null

# Claude ships no completion generator, so the ccd family gets a hand-written
# spec of the flags actually reached for day to day. Without one, fzf-tab falls
# back to filenames and offers the whole home directory, which is never the
# answer to "what did I want to pass claude?".
_ccd_family() {
  _arguments -S \
    '(-c --continue)'{-c,--continue}'[continue the most recent conversation]' \
    '(-r --resume)'{-r,--resume}'[resume a session]:session-id:' \
    '(-p --print)'{-p,--print}'[non-interactive print mode]:prompt:' \
    '--model[model for this session]:model:(opus sonnet haiku)' \
    '--agent[agent for this session]:agent:' \
    '--agents[JSON defining custom agents]:json:' \
    '--add-dir[additional allowed directory]:dir:_files -/' \
    '--append-system-prompt[append to the system prompt]:prompt:' \
    '--effort[effort level]:level:(low medium high)' \
    '--fallback-model[fallback when the primary is unavailable]:model:' \
    '(--bg --background)'{--bg,--background}'[start the session in the background]' \
    '(-d --debug)'{-d,--debug}'[debug mode]' \
    '*::claude args:'
}
compdef _ccd_family ccd ccds ccdw ccdr ccdrs ccdrw

# agents-doctor takes only --deep/--help; without a spec zsh offers filenames.
_agents_doctor() {
  _arguments -S \
    '--deep[also make one real round trip per harness (slow)]' \
    '(-h --help)'{-h,--help}'[usage]'
}
compdef _agents_doctor agents-doctor

# `claude-local <TAB>` -> its own flags, and installed Ollama tags after -m.
# Without a spec, fzf-tab falls back to filename completion and offers the
# whole home directory, which is never the answer to "which model?".
#
# The derived -cc tags are filtered out deliberately: they are an internal
# detail of the context-length workaround, and picking one would only produce
# a redundant round trip through cl_base_of.
_claude_local_models() {
  compadd -- ${(f)"$(ollama list 2>/dev/null | awk 'NR>1 && $1 != "" {print $1}' | grep -v -- '-cc$')"}
}
#
# The split is deliberate: a bare TAB completes the command's own options, and
# model tags appear only where a model is actually being asked for — after
# --pick, --set or -m. Offering tags at the top level instead was worse on both
# counts: it buried the flags, and it answered a question the user had not
# asked yet.
#
# zsh will still insert the shared "-" when every candidate is an option. That
# is ordinary behavior for any command, and claude-local now discards a lone
# dash rather than forwarding it as claude's prompt.
_claude_local() {
  _arguments -S \
    '(-m --model)'{-m,--model}'[Ollama tag to run]:model:_claude_local_models' \
    '--ctx[context window in tokens]:tokens:(8192 16384 32768 65536 131072)' \
    '--pick[choose a model for this run]::model:_claude_local_models' \
    '--set[choose a model and save it as the default]::model:_claude_local_models' \
    '(-l --list)'{-l,--list}'[list installed models]' \
    '(-h --help)'{-h,--help}'[usage]' \
    '(-c --continue)'{-c,--continue}'[continue the last local conversation]' \
    '(-p --print)'{-p,--print}'[print mode]:prompt:' \
    '(-r --resume)'{-r,--resume}'[resume a session]' \
    '*::claude args:'
}
compdef _claude_local claude-local

# Bare model tag as the first argument, so `claude-local-setup <TAB>` offers
# what is already installed rather than files.
_claude_local_setup() { _claude_local_models }
compdef _claude_local_setup claude-local-setup
