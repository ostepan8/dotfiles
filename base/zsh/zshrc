# ---------- PATH + env ----------
export EDITOR=nvim
export PATH="$HOME/.cargo/bin:$PATH"
export PATH="$HOME/.local/bin:$PATH"

# ---------- mac-only paths ----------
if [[ "$(uname)" == "Darwin" ]]; then
    [ -d "$HOME/Desktop/vcpkg" ] && export PATH="$PATH:$HOME/Desktop/vcpkg"
    # NODE_OPTIONS=--use-openssl-ca intentionally omitted — conflicts with
    # NODE_USE_SYSTEM_CA (see commit 607e294).
    export AWS_CA_BUNDLE=/etc/ssl/cert.pem
    [ -f "/opt/homebrew/etc/ca-certificates/cert.pem" ] && export SSL_CERT_FILE="/opt/homebrew/etc/ca-certificates/cert.pem"
    [ -d "$HOME/Qt/5.15.2/clang_64/bin" ] && export PATH="$PATH:$HOME/Qt/5.15.2/clang_64/bin"
    [ -d "/Applications/MATLAB_R2024b.app" ] && export PATH="/Applications/MATLAB_R2024b.app/bin:$PATH"
    [ -d "/Applications/MATLAB_R2023a.app" ] && export PATH="/Applications/MATLAB_R2023a.app/bin:$PATH"
fi

# ---------- history ----------
HISTFILE=~/.zsh_history
HISTSIZE=50000
SAVEHIST=50000
setopt SHARE_HISTORY
setopt HIST_IGNORE_DUPS
setopt HIST_IGNORE_ALL_DUPS
setopt HIST_IGNORE_SPACE
setopt HIST_REDUCE_BLANKS
setopt HIST_VERIFY
setopt EXTENDED_HISTORY
setopt APPEND_HISTORY
setopt INC_APPEND_HISTORY

# ---------- quality-of-life setopts ----------
setopt AUTO_CD               # `dirname` ≡ `cd dirname`
setopt AUTO_PUSHD            # `cd` pushes the old dir onto the stack
setopt PUSHD_IGNORE_DUPS     # don't stack the same dir twice
setopt PUSHD_SILENT          # don't print the dir stack on every cd
setopt EXTENDED_GLOB         # ^, ~, # globbing operators
setopt INTERACTIVE_COMMENTS  # allow `cmd # comment` on the command line
setopt COMPLETE_IN_WORD      # completion can split a word at the cursor
setopt NO_BEEP               # no bell

# ---------- conda (lazy) ----------
if [ -d "/opt/anaconda3" ]; then
    load_conda() {
        unset -f conda mamba load_conda 2>/dev/null
        __conda_setup="$('/opt/anaconda3/bin/conda' 'shell.zsh' 'hook' 2> /dev/null)"
        if [ $? -eq 0 ]; then
            eval "$__conda_setup"
        else
            if [ -f "/opt/anaconda3/etc/profile.d/conda.sh" ]; then
                . "/opt/anaconda3/etc/profile.d/conda.sh"
            else
                export PATH="/opt/anaconda3/bin:$PATH"
            fi
        fi
        unset __conda_setup
    }
    conda() { load_conda; conda "$@"; }
    mamba() { load_conda; mamba "$@"; }
fi

# ---------- nvm (lazy) ----------
export NVM_DIR="$HOME/.nvm"
if [ -s "$NVM_DIR/nvm.sh" ]; then
    load_nvm() {
        unset -f nvm node npm npx yarn pnpm corepack load_nvm 2>/dev/null
        \. "$NVM_DIR/nvm.sh"
        [ -s "$NVM_DIR/bash_completion" ] && \. "$NVM_DIR/bash_completion"
    }
    nvm()      { load_nvm; nvm "$@"; }
    node()     { load_nvm; node "$@"; }
    npm()      { load_nvm; npm "$@"; }
    npx()      { load_nvm; npx "$@"; }
    yarn()     { load_nvm; yarn "$@"; }
    pnpm()     { load_nvm; pnpm "$@"; }
    corepack() { load_nvm; corepack "$@"; }
fi

# ---------- bun ----------
export BUN_INSTALL="$HOME/.bun"
export PATH="$BUN_INSTALL/bin:$PATH"
[ -s "$HOME/.bun/_bun" ] && source "$HOME/.bun/_bun"

# ---------- opencode ----------
[ -d "$HOME/.opencode/bin" ] && export PATH="$HOME/.opencode/bin:$PATH"

# ---------- prompt ----------
command -v starship >/dev/null && eval "$(starship init zsh)"

# ---------- aliases ----------
if [[ "$(uname)" == "Darwin" ]]; then
    alias code="zed"
    alias cursor='open -a Cursor'
fi
alias claude-tg="claude --channels plugin:telegram@claude-plugins-official"
alias ccrd="claude --resume --dangerously-skip-permissions"
# Default CLAUDE_CONFIG_DIR so bare `claude` runs against the personal
# config. The aliases and ccd/ccds/ccdw functions below override per-call.
# Also normalize a literal tilde in case something downstream set it as
# "~/..." without shell expansion (which would otherwise resolve relative
# to CWD and scatter state directories around).
export CLAUDE_CONFIG_DIR="$HOME/.claude-personal"
[[ "${CLAUDE_CONFIG_DIR-}" == "~/"* ]] && export CLAUDE_CONFIG_DIR="$HOME/${CLAUDE_CONFIG_DIR#~/}"

alias claude-personal='CLAUDE_CONFIG_DIR="$HOME/.claude-personal" claude'
alias claude-school='CLAUDE_CONFIG_DIR="$HOME/.claude-school" claude'
function _ccd_title() {
  local label="$1"; shift
  (while true; do printf '\033]0;%s\007' "$label" > /dev/tty 2>/dev/null; sleep 1; done) &
  local _pid=$!
  "$@"
  kill $_pid 2>/dev/null
  printf '\033]0;\007' > /dev/tty
}
function ccd()  { _ccd_title "Claude · ohstep23@gmail.com"       env CLAUDE_CONFIG_DIR="$HOME/.claude-personal" claude --dangerously-skip-permissions "$@"; }
function ccds() { _ccd_title "Claude · stepan.o@northeastern.edu" env CLAUDE_CONFIG_DIR="$HOME/.claude-school"   claude --dangerously-skip-permissions "$@"; }
function ccdw() { _ccd_title "Claude · owen@subconscious.dev"     env CLAUDE_CONFIG_DIR="$HOME/.claude-work"     claude --dangerously-skip-permissions "$@"; }
function ccdr()  { ccd  --resume "$@"; }
function ccdrs() { ccds --resume "$@"; }
function ccdrw() { ccdw --resume "$@"; }

# Isolated profile for a locally-served model: no MCP servers, no plugins, no
# personal skills/rules — keeps Claude Code's system prompt small so a local
# model (slow prefill, no server-side prompt caching) stays responsive. Points
# at Ollama's Anthropic-compatible endpoint.
#
# Shared rather than macbook-only: defining a function costs nothing on a
# machine that never calls it, and either Mac may run Ollama.
function ccd-local() {
  _ccd_title "Claude · local (qwen3.6)" \
    env CLAUDE_CONFIG_DIR="$HOME/.claude-local" \
        ANTHROPIC_BASE_URL="http://localhost:11434" \
        ANTHROPIC_AUTH_TOKEN="ollama" \
        ANTHROPIC_API_KEY="" \
    claude --dangerously-skip-permissions "$@"
}

alias ll='ls -lh'
alias la='ls -lAh'
alias ..='cd ..'
alias ...='cd ../..'
alias ....='cd ../../..'
alias gs='git status'
alias gd='git diff'
alias gco='git checkout'
alias gl='git log --oneline --graph --decorate -20'
alias reload='source ~/.zshrc'
alias e='exit'

# tmux
alias nts='tmux new-session -s'   # nts <name>  -> new named session
alias tns='tmux new-session -s'   # tns <name>  -> alias of nts

# ta [name] -> attach. A function rather than an alias so it can carry its own
# completion: zsh expands aliases before completing, so `alias ta='tmux attach'`
# completed as `tmux attach <TAB>`, which offers flags — session names only
# complete after -t. Completion is registered below, after compinit.
#
# Clear any stale `ta` alias first. zsh expands aliases before resolving
# functions, so an older `alias ta=...` still live in a re-sourced session
# would shadow this function entirely — `reload` would silently keep the old
# behavior. unalias makes re-sourcing converge to the function, not just a
# fresh shell.
unalias ta 2>/dev/null || true
ta() {
  if [ $# -gt 0 ]; then
    tmux attach -t "$1"      # explicit target; let a bad name report its error
  else
    tmux attach              # no arg -> most recent session
  fi
}

# ---------- completions + plugins ----------
autoload -Uz compinit && compinit

# `ta <TAB>` -> live tmux session names. Must follow compinit, since compdef is
# defined by it. (f) splits on newlines so session names containing spaces
# survive as single candidates.
_ta() { compadd -- ${(f)"$(tmux list-sessions -F '#S' 2>/dev/null)"} }
compdef _ta ta
for __antidote in \
    /opt/homebrew/opt/antidote/share/antidote/antidote.zsh \
    /usr/local/opt/antidote/share/antidote/antidote.zsh \
    "$HOME/.antidote/antidote.zsh" \
    /usr/share/zsh-antidote/antidote.zsh; do
    if [ -f "$__antidote" ]; then
        source "$__antidote"
        antidote load
        break
    fi
done
unset __antidote

bindkey '^[[A' history-substring-search-up
bindkey '^[[B' history-substring-search-down

# ---------- fzf + zoxide ----------
command -v fzf >/dev/null && source <(fzf --zsh)
command -v zoxide >/dev/null && eval "$(zoxide init zsh)"

# ---------- atuin ----------
command -v atuin >/dev/null && eval "$(atuin init zsh --disable-up-arrow)"

# ---------- nephos ----------
# Sourced only when this machine is set up for the personal cloud. The helpers
# fetch credentials on demand into this shell and never write them to disk.
[ -f "$HOME/dotfiles/base/zsh/nephos.zsh" ] && source "$HOME/dotfiles/base/zsh/nephos.zsh"

# ---------- host-type overrides ----------
# ~/.dotfiles-host holds this machine's *type* ("macbook", "studio"), not a
# unique per-device id — a second Studio would get the same file. It lives
# outside the repo so it's never synced; only the file it points at
# (zsh/hosts/<type>.zsh) is version-controlled and shared like everything
# else, so type-specific config still propagates across every machine of
# that type via the normal sync.
if [ -f "$HOME/.dotfiles-host" ] && [ -f "$HOME/dotfiles/hosts/$(<"$HOME/.dotfiles-host").zsh" ]; then
    source "$HOME/dotfiles/hosts/$(<"$HOME/.dotfiles-host").zsh"
fi
