#!/usr/bin/env bash
#
# claude-local-setup — install a model for claude-local to drive, and make it
# the default. Idempotent: safe to re-run on a new machine or after a pull that
# was interrupted (Ollama resumes from the partial blob).
#
#   claude-local-setup                  pick from what is already installed
#   claude-local-setup qwen3.8:27b      pull if needed, then set as default

set -euo pipefail

SELF="$0"
while [[ -L "$SELF" ]]; do
  link="$(readlink "$SELF")"
  [[ "$link" == /* ]] && SELF="$link" || SELF="$(dirname "$SELF")/$link"
done
# shellcheck source=lib/claude-local-lib.sh
source "$(cd "$(dirname "$SELF")" && pwd)/lib/claude-local-lib.sh"

command -v ollama >/dev/null 2>&1 || cl_die "ollama is not installed (brew install ollama)"
cl_ensure_server "${CLAUDE_LOCAL_HOST:-http://localhost:11434}"

base="${1:-}"
if [[ -z "$base" ]]; then
  base="$(cl_pick_model)" || cl_die "nothing selected"
fi
base="$(cl_base_of "$base")"

cl_step "Base weights: $base"
if cl_model_exists "$base"; then
  echo "    already installed" >&2
else
  ollama pull "$base"
fi

derived="$(cl_ensure_derived "$base" "$DEFAULT_CTX")"

cl_step "Verifying context length"
ctx="$(cl_ctx_of "$derived")"
[[ -n "$ctx" ]] || cl_die "could not read num_ctx back from '$derived'"
[[ "$ctx" -ge 32768 ]] || cl_die "num_ctx is only $ctx — Claude Code needs far more"
echo "    $derived → num_ctx $ctx" >&2

cl_save_model "$base"
printf '\n\033[32mReady.\033[0m Default is %s. Run: claude-local\n' "$base"
