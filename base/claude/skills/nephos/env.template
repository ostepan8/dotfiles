# Copy to ~/.config/nephos/env and fill in for this machine. chmod 600.
# Never commit the filled-in version — dotfiles is a public repo.
NEPHOS_CONTROL_ADDR=http://127.0.0.1:7930
NEPHOS_CONTROL_HOST=<ssh-alias-of-control-plane-node>
NEPHOS_BIN=~/bin/nephos
NEPHOS_DOMAIN=<your-domain>
NEPHOS_API=https://api.<your-domain>
NEPHOS_LLM=https://llm.<your-domain>/v1
NEPHOS_S3=https://s3.<your-domain>
NEPHOS_NODES="<ssh-alias> <ssh-alias> ..."
